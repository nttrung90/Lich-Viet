<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Full-screen Landscape Background (changes daily) -->
    <ImageView
        android:id="@+id/iv_day_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_folk_dam_cuoi_chuot"
        android:contentDescription="Tranh dân gian lịch ngày"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top App Bar with subtle translucent gradient -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:background="@drawable/bg_folk_header"
        android:paddingHorizontal="14dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Month - Year Selector -->
        <LinearLayout
            android:id="@+id/btn_select_month_year"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/tv_month_year"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tháng 08 - 2019"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="4" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="▼"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="4" />
        </LinearLayout>

        <!-- Bát Quái Tử Vi icon -->
        <ImageView
            android:id="@+id/btn_crown"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="Tử vi"
            android:src="@drawable/ic_bat_quai"
            app:layout_constraintEnd_toStartOf="@id/btn_event"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Event / Today icon -->
        <ImageView
            android:id="@+id/btn_event"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Sự kiện"
            android:src="@drawable/ic_calendar_event"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Main Calendar Gesture Swipe Container (Fills rest of screen) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_swipe_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- "Hôm Nay" Quick Badge Button -->
        <LinearLayout
            android:id="@+id/btn_today"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_today_badge"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_nav_day" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hôm nay"
                android:textColor="#1B5E20"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- "Đổi Tranh" Quick Badge Button -->
        <LinearLayout
            android:id="@+id/btn_change_wallpaper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_today_badge"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_today">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_wallpaper" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đổi tranh"
                android:textColor="#1B5E20"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Weather & Temperature Badge (Opposite to "Hôm nay", "Đổi tranh") -->
        <LinearLayout
            android:id="@+id/btn_weather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_today_badge"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/iv_weather_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_weather_sun_cloud" />

            <TextView
                android:id="@+id/tv_weather_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="29°C"
                android:textColor="#1B5E20"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_weather_city"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hà Nội"
                android:textColor="#2E7D32"
                android:textSize="8sp" />
        </LinearLayout>

        <!-- Big Solar Day Number -->
        <TextView
            android:id="@+id/tv_solar_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="20"
            android:textColor="#1E1656"
            android:textSize="115sp"
            android:includeFontPadding="false"
            android:textStyle="bold"
            android:shadowColor="#FFFFFF"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="10"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Day of Week -->
        <TextView
            android:id="@+id/tv_day_of_week"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:text="THỨ BẢY"
            android:textColor="#1E1656"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:shadowColor="#FFFFFF"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="8"
            app:layout_constraintTop_toBottomOf="@id/tv_solar_day"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Folk Quote / Proverb (Floating naturally over background) -->
        <TextView
            android:id="@+id/tv_folk_quote"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="32dp"
            android:layout_marginBottom="6dp"
            android:gravity="center"
            android:text="Chín bỏ làm mười"
            android:textColor="#1B4332"
            android:textSize="16sp"
            android:textStyle="bold|italic"
            android:lineSpacingExtra="3dp"
            android:shadowColor="#E6FFFFFF"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="8"
            app:layout_constraintBottom_toTopOf="@id/tv_quote_author"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Quote Author -->
        <TextView
            android:id="@+id/tv_quote_author"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="32dp"
            android:layout_marginBottom="16dp"
            android:text="Thành ngữ Việt Nam"
            android:textColor="#2D5A43"
            android:textSize="12sp"
            android:textStyle="italic"
            android:shadowColor="#E6FFFFFF"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="6"
            app:layout_constraintBottom_toTopOf="@id/panel_lunar_info"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Lower Panel: Lunar Date & Can Chi Information (Translucent Mint Glass Card) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/panel_lunar_info"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_folk_panel"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Column 1: Time & Can Chi Hour -->
            <LinearLayout
                android:id="@+id/col_time"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/divider_1"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:id="@+id/tv_clock_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="11:56"
                    android:textColor="#1B5E20"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="4dp"
                        android:src="@drawable/ic_yin_yang" />

                    <TextView
                        android:id="@+id/tv_can_chi_hour"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tân Mùi"
                        android:textColor="#2E7D32"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Divider 1 -->
            <View
                android:id="@+id/divider_1"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginVertical="8dp"
                android:background="#80A5D6A7"
                app:layout_constraintStart_toEndOf="@id/col_time"
                app:layout_constraintEnd_toStartOf="@id/col_lunar_day" />

            <!-- Column 2: Big Lunar Day & Month -->
            <LinearLayout
                android:id="@+id/col_lunar_day"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                app:layout_constraintStart_toEndOf="@id/divider_1"
                app:layout_constraintEnd_toStartOf="@id/divider_2"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:id="@+id/tv_lunar_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12"
                    android:textColor="#1B5E20"
                    android:textSize="36sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="3dp"
                        android:src="@drawable/ic_yin_yang" />

                    <TextView
                        android:id="@+id/tv_lunar_month"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tháng 8"
                        android:textColor="#2E7D32"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Divider 2 -->
            <View
                android:id="@+id/divider_2"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginVertical="8dp"
                android:background="#80A5D6A7"
                app:layout_constraintStart_toEndOf="@id/col_lunar_day"
                app:layout_constraintEnd_toStartOf="@id/col_can_chi" />

            <!-- Column 3: Can Chi of Day, Month, Year -->
            <LinearLayout
                android:id="@+id/col_can_chi"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                app:layout_constraintStart_toEndOf="@id/divider_2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:id="@+id/tv_canchi_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ng. Giáp Thân"
                    android:textColor="#1B5E20"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_canchi_month"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Th. Canh Thân"
                    android:textColor="#2E7D32"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_canchi_year"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Năm Kỷ Hợi"
                    android:textColor="#2E7D32"
                    android:textSize="11sp" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
