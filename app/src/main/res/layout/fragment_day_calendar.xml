<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#4A148C">

    <!-- Top App Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_folk_header"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Weather Button -->
        <ImageView
            android:id="@+id/btn_weather"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="Thời tiết"
            android:src="@drawable/ic_weather_sun_cloud"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Month - Year Selector -->
        <LinearLayout
            android:id="@+id/btn_select_month_year"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/tv_month_year"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tháng 08 - 2019"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="▼"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Crown VIP icon -->
        <ImageView
            android:id="@+id/btn_crown"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="Tử vi"
            android:src="@drawable/ic_crown"
            app:layout_constraintEnd_toStartOf="@id/btn_event"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Event icon -->
        <ImageView
            android:id="@+id/btn_event"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="Sự kiện"
            android:src="@drawable/ic_calendar_event"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Main Calendar Page Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_calendar_page"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintBottom_toTopOf="@id/bottom_banner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_swipe_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_folk_day_card">

            <!-- "Hôm Nay" Quick Badge Button -->
            <LinearLayout
                android:id="@+id/btn_today"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_today_badge"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="6dp"
                android:paddingVertical="4dp"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_nav_day" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hôm nay"
                    android:textColor="#00796B"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Big Solar Day Number -->
            <TextView
                android:id="@+id/tv_solar_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="20"
                android:textColor="@color/solar_day_color"
                android:textSize="84sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Day of Week -->
            <TextView
                android:id="@+id/tv_day_of_week"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="THỨ HAI"
                android:textColor="@color/solar_day_color"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                app:layout_constraintTop_toBottomOf="@id/tv_solar_day"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Folk Quote / Proverb -->
            <TextView
                android:id="@+id/tv_folk_quote"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="32dp"
                android:layout_marginTop="70dp"
                android:gravity="center"
                android:text="Chín bỏ làm mười"
                android:textColor="#2E7D32"
                android:textSize="15sp"
                android:textStyle="bold|italic"
                app:layout_constraintTop_toBottomOf="@id/tv_day_of_week"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Quote Author -->
            <TextView
                android:id="@+id/tv_quote_author"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="32dp"
                android:text="Thành ngữ Việt Nam"
                android:textColor="#388E3C"
                android:textSize="12sp"
                app:layout_constraintTop_toBottomOf="@id/tv_folk_quote"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Lower Panel: Lunar Date & Can Chi Information -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/panel_lunar_info"
                android:layout_width="0dp"
                android:layout_height="96dp"
                android:layout_marginHorizontal="10dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_folk_panel"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Column 1: Time & Can Chi Hour -->
                <LinearLayout
                    android:id="@+id/col_time"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/divider_1"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <TextView
                        android:id="@+id/tv_clock_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="14:10"
                        android:textColor="#1B5E20"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginEnd="4dp"
                            android:src="@drawable/ic_yin_yang" />

                        <TextView
                            android:id="@+id/tv_can_chi_hour"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tân Mùi"
                            android:textColor="#2E7D32"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Divider 1 -->
                <View
                    android:id="@+id/divider_1"
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginVertical="8dp"
                    android:background="#A5D6A7"
                    app:layout_constraintStart_toEndOf="@id/col_time"
                    app:layout_constraintEnd_toStartOf="@id/col_lunar_day" />

                <!-- Column 2: Big Lunar Day & Month -->
                <LinearLayout
                    android:id="@+id/col_lunar_day"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    app:layout_constraintStart_toEndOf="@id/divider_1"
                    app:layout_constraintEnd_toStartOf="@id/divider_2"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <TextView
                        android:id="@+id/tv_lunar_day"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10"
                        android:textColor="@color/lunar_day_color"
                        android:textSize="36sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_lunar_month"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tháng 7"
                        android:textColor="@color/lunar_day_color"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Divider 2 -->
                <View
                    android:id="@+id/divider_2"
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginVertical="8dp"
                    android:background="#A5D6A7"
                    app:layout_constraintStart_toEndOf="@id/col_lunar_day"
                    app:layout_constraintEnd_toStartOf="@id/col_can_chi" />

                <!-- Column 3: Can Chi of Day, Month, Year -->
                <LinearLayout
                    android:id="@+id/col_can_chi"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    app:layout_constraintStart_toEndOf="@id/divider_2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <TextView
                        android:id="@+id/tv_canchi_day"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ng. Giáp Thân"
                        android:textColor="#1B5E20"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_canchi_month"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Th. Canh Thân"
                        android:textColor="#1B5E20"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_canchi_year"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Năm Mậu Tuất"
                        android:textColor="#1B5E20"
                        android:textSize="11sp" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <!-- Bottom Folk Banner (Thông Tin Chính Xác) -->
    <LinearLayout
        android:id="@+id/bottom_banner"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="#0E4DA4"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Top Yellow Stripe -->
        <View
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="#FFD700" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thông Tin Chính Xác"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.03" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
