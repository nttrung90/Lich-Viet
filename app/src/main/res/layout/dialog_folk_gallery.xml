<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tv_gallery_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="23 Kiệt Tác Tranh Dân Gian"
                android:textColor="#1B5E20"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_gallery_counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="1 / 23"
                android:textColor="#888888"
                android:textSize="14sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Artwork Image -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="220dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/iv_gallery_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Tranh Dân Gian"
                android:src="@drawable/bg_folk_dam_cuoi_chuot" />
        </androidx.cardview.widget.CardView>

        <!-- Title & School -->
        <TextView
            android:id="@+id/tv_gallery_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Đám cưới chuột"
            android:textColor="#1A365D"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_gallery_school"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Tranh Dân Gian Đông Hồ"
            android:textColor="#B71C1C"
            android:textSize="13sp"
            android:textStyle="italic" />

        <!-- Meaning Description -->
        <TextView
            android:id="@+id/tv_gallery_meaning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:text="Bức tranh trứ danh vừa mang tính trào lộng sâu sắc vừa thể hiện khát vọng hòa bình, dĩ hòa vi quý, chúc cho cuộc sống luôn yên vui thái bình."
            android:textColor="#444444"
            android:textSize="13sp" />

        <!-- Navigation Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btn_gallery_prev"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:padding="0dp"
                android:text="Tranh Trước"
                android:textColor="#1B5E20"
                android:textSize="12sp"
                app:strokeColor="#1B5E20" />

            <Button
                android:id="@+id/btn_gallery_next"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:padding="0dp"
                android:text="Tranh Sau"
                android:textColor="#1B5E20"
                android:textSize="12sp"
                app:strokeColor="#1B5E20" />
        </LinearLayout>

        <!-- Close Button -->
        <Button
            android:id="@+id/btn_gallery_close"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#1B5E20"
            android:text="Đóng"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
