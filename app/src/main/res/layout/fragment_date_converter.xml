<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#77BCA5">

    <!-- Header Title -->
    <TextView
        android:id="@+id/tv_title_convert"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/title_convert"
        android:textColor="#1A365D"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tab Selector (Đổi ngày | Tìm ngày tốt) -->
    <LinearLayout
        android:id="@+id/layout_tabs"
        android:layout_width="280dp"
        android:layout_height="38dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_tab_container"
        android:padding="2dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/tv_title_convert"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tab_doi_ngay"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_selected"
            android:gravity="center"
            android:text="@string/tab_convert_date"
            android:textColor="#1A365D"
            android:textSize="14sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tab_tim_ngay_tot"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_unselected"
            android:gravity="center"
            android:text="@string/tab_find_good_day"
            android:textColor="#4A5568"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Scrollable Content Area -->
    <ScrollView
        android:id="@+id/scroll_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/layout_tabs"
        app:layout_constraintBottom_toTopOf="@id/bottom_banner_convert"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:gravity="center_horizontal">

            <!-- Container for Tab 1: Đổi ngày -->
            <LinearLayout
                android:id="@+id/container_doi_ngay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <!-- Section: Dương Lịch -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="☀  Dương Lịch"
                    android:textColor="#1A365D"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Dương Lịch Pickers Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_marginTop="8dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <NumberPicker
                            android:id="@+id/picker_solar_day"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <NumberPicker
                            android:id="@+id/picker_solar_month"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <NumberPicker
                            android:id="@+id/picker_solar_year"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Section: Âm Lịch -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="☾  Âm Lịch"
                    android:textColor="#1A365D"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Âm Lịch Pickers Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_marginTop="8dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <NumberPicker
                            android:id="@+id/picker_lunar_day"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <NumberPicker
                            android:id="@+id/picker_lunar_month"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <NumberPicker
                            android:id="@+id/picker_lunar_year"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Button: Xem chi tiết ngày -->
                <TextView
                    android:id="@+id/btn_view_day_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_button_rounded"
                    android:text="@string/btn_view_day_detail"
                    android:textColor="#4A154B"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <!-- Container for Tab 2: Tìm ngày tốt -->
            <LinearLayout
                android:id="@+id/container_tim_ngay_tot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Chọn mục đích tìm ngày tốt:"
                    android:textColor="#1A365D"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinner_purpose"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_folk_card"
                    android:paddingHorizontal="12dp" />

                <TextView
                    android:id="@+id/tv_find_result_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Danh sách các ngày Hoàng Đạo trong tháng:"
                    android:textColor="#1A365D"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_good_days"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Orange Banner (Đổi Ngày Âm - Dương) -->
    <LinearLayout
        android:id="@+id/bottom_banner_convert"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="#FF6B00"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Top Yellow Stripe -->
        <View
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="#FFD700" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đổi Ngày Âm - Dương"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.03" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
